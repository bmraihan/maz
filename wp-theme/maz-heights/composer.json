{
    "name": "maz-heights/theme",
    "description": "Custom WordPress theme for MAZ Heights (Coventry extensions, kitchens & bathrooms contractor).",
    "type": "wordpress-theme",
    "license": "proprietary",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "brain/monkey": "^2.6",
        "squizlabs/php_codesniffer": "^3.9"
    },
    "autoload-dev": {
        "psr-4": {
            "MazHeights\\Tests\\": "tests/php/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "lint": "phpcs --standard=PSR12 inc functions.php"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
